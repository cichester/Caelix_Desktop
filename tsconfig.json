{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "strict": true,
        "jsx": "react",
        "baseUrl": ".",
        "paths": {
            "*": ["*", "*.web", "*.native", "*.ios", "*.android"],
            "src/*": ["src/*"]
        },
        "inlineSources": true,
        "sourceRoot": "/",
        "outDir": "./dist",
        "skipLibCheck": true
    }
}
