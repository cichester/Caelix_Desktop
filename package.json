{
  "name": "caelix-desktop",
  "productName": "Caelix",
  "description": "Caelix Desktop client",
  "author": "Caelix Team",
  "version": "1.0.1",
  "private": true,
  "main": "./out/main/main.js",
  "scripts": {
    "dev": "concurrently -k -n \"frontend,desktop\" -c \"cyan,magenta\" \"npm --prefix \\\"../Caelix Frontend\\\" run dev\" \"electron-vite dev\"",
    "dev:desktop-only": "electron-vite dev",
    "build": "electron-vite build",
    "package": "npm run build && electron-builder --win nsis",
    "package:publish": "npm run build && electron-builder --win nsis --publish always",
    "package:dir": "npm run build && electron-builder --win --dir",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "electron-dl": "^3.5.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "source-map-support": "^0.5.21",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "concurrently": "^10.0.6",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "it.caelix.desktop",
    "productName": "Caelix",
    "directories": {
      "output": "dist-package"
    },
    "files": [
      "out/**/*",
      "icon-source/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Caelix Protocol",
        "schemes": [
          "caelix"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "cichester",
        "repo": "Caelix_Desktop"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon-source/icon.png",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Caelix"
    }
  }
}
